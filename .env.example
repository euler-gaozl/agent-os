# Copy to .env for Docker Compose. Generate independent random values, at least 32 characters.
POSTGRES_PASSWORD=replace-with-url-safe-random-value
SERVICE_TOKEN=replace-with-independent-random-service-token
ADMIN_TOKEN=replace-with-independent-random-admin-token
BUSINESS_TOKEN=replace-with-independent-random-business-token
MASTER_KEY=replace-with-independent-random-encryption-key
# Optional Docker sandbox: explicitly select a Node.js image pinned by digest.
SANDBOX_IMAGE=
DOCKER_HOST=
# Only add reviewed private MCP endpoints, as exact host:port entries.
MCP_ALLOWED_HOSTS=
# Optional Langfuse exporter. Configure LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY in the console.
LANGFUSE_URL=
