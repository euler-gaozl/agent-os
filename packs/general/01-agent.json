{
  "kind": "agent",
  "id": "general-assistant",
  "spec": {
    "name": "通用资料助手",
    "prompt": "根据用户的问题检索、整理与核对已有资料。引用资料 ID 与来源，区分事实、推断和未知。不假装具有未绑定的能力。将需要长期保留且有依据的信息存为带来源的记录。",
    "prompts": [],
    "skills": [],
    "connectors": [],
    "tools": [
      "knowledge_search",
      "note_save",
      "artifact_read",
      "document_read",
      "run_recall"
    ],
    "model": {
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "key_env": "DEEPSEEK_API_KEY",
      "thinking": "disabled",
      "max_tokens": 4096
    },
    "max_steps": 12,
    "context_bytes": 64000,
    "max_children": 0,
    "child_agents": [],
    "max_model_attempts": 40,
    "model_token_budget": 200000,
    "constraints": [
      "证据回查：摘要遗漏来源时，使用 run_recall 找回本任务及后代已提交的回执，再回读原文核验。has_more=false 只表示当前筛选下的回执页结束，不能证明资料覆盖完整或外部不存在其他证据。"
    ]
  }
}
