%% 存储职责视图：多个逻辑区域可共用数据库实例，但权限、模式和生命周期独立。
%% 每次模型请求保存 ContextManifest，引用准确的数据、规则、Skill、工具和记忆版本。
%% 模型请求结果只有确认持久化后才允许推动有副作用的后续动作。
%% 摘要和检索索引可重建；它们不能覆盖原始事实、有效用户约束和调用回执。
%% 垃圾回收根包括活动任务、保留的检查点、数据版本、报告、有效记忆和手动保留对象。
%% 到期且无引用、无租约、无保留标记的对象，标记待删除并过宽限期后再删除。
%% 旧数据被修订不等于可删；引用与保留窗口决定可回溯范围。
flowchart TB
    subgraph DURABLE["持久化存储：明确数据所有者与提交边界"]
        RUN["运行库<br/>任务契约 · 事件 · 检查点<br/>调用意图 / 回执 · 子任务 · 版本清单"]
        OBJ["证据与产物库<br/>原始网页 / 报告 · 脚本 · 暂存结果<br/>来源 · 哈希 · 稳定引用 · 发布状态"]
        FACT["业务事实库<br/>指标值 · 单位 · 样本口径<br/>统计时间 · 发布时间 · 入库时间 · 修订版本"]
        MEM["长期记忆库<br/>偏好 · 已确认方法 · 用户纠正<br/>来源 · 作用范围 · 有效期 · 版本"]
    end

    OBJ --> IDX["派生索引与缓存<br/>全文 / 向量索引 · 解析缓存 · 摘要"]
    MEM --> IDX
    RUN --> CTX["上下文管理器"]
    FACT --> CTX
    IDX -->|"发现资料后按引用读取原文"| CTX
    MEM --> CTX
    OBJ --> CTX
    CTX --> MAN["保存上下文清单<br/>本次读取的具体内容与版本"]
    MAN --> MODEL["模型工作集<br/>必需约束 + 当前步骤材料 + 历史入口"]

    MODEL --> CMP["需要 Compact"]
    CMP --> CHECK["确认状态与产物已提交<br/>生成候选摘要<br/>校验必需字段和引用<br/>保存旧版本"]
    CHECK --> CTX

    ROOT["保留根与租约<br/>任务 · 检查点 · 数据版本<br/>报告 · 有效记忆 · 手动保留"] --> GC["引用检查 + 保留期策略<br/>标记待删 → 宽限期 → 回收"]
    GC -. "按各类策略清理" .-> DURABLE
    GC -. "可重建缓存按需清理" .-> IDX
